{
  "info": {
    "name": "Bank Marketing Subscription Predictor",
    "description": "CLD 375 final project. Set the base_url variable to http://<elastic-ip>:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://13.219.134.164:8000"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Both ok', function () { const b = pm.response.json(); pm.expect(b.backend).to.eql('ok'); pm.expect(b.model_service).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Predictions",
      "item": [
        {
          "name": "Likely yes (expect 0.9273, yes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/predict",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "predict"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project\": \"de-ml-final\",\n  \"age\": 30,\n  \"job\": \"student\",\n  \"marital\": \"single\",\n  \"education\": \"professional.course\",\n  \"default\": \"no\",\n  \"contact\": \"cellular\",\n  \"month\": \"sep\",\n  \"day_of_week\": \"tue\",\n  \"campaign\": 2,\n  \"days_since_last_contact\": 6,\n  \"previous\": 1,\n  \"poutcome\": \"success\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Prediction is yes', function () { pm.expect(body.prediction).to.eql('yes'); });",
                  "pm.test('Probability is 0.9273', function () { pm.expect(body.subscribe_probability).to.be.closeTo(0.9273, 0.00005); });"
                ]
              }
            }
          ]
        },
